#!/usr/bin/env python3
"""A ``gh`` stub: it records how it was called, and it talks to nobody.

Why a stub at all
-----------------
The finishing stage performs outward-facing actions through ``gh`` — a
pull request gets created, a branch gets pushed.  A test that lets those
reach the real ``gh`` talks to the network, depends on the machine's
credentials, and leaves a pull request behind.  So the suite ships its
own ``gh``: put this directory first on ``PATH`` and every ``gh`` call
lands here instead.

What it records
---------------
Every invocation appends **one line** to the JSONL file named by the
environment variable ``GH_CALLS_JSONL`` (or to ``GH_CALLS.jsonl`` in
the working directory when that variable is unset).  The line is the
caller's ``argv`` — the arguments after the program name — as a JSON
array, verbatim: nothing is dropped, nothing is re-spelled, nothing is
interpreted.  A case asserts on it by reading the file back.

The arguments are recorded, never executed.  That is the whole point:
the stub is evidence that the finishing stage *asked* for the right
thing, not a machine that does the thing.

What it prints
--------------
A fixed JSON object on stdout, so a caller that parses the stub's
output has something deterministic to parse.  It deliberately does not
imitate any subcommand's real payload — a case that needs one shapes
it itself.
"""

from __future__ import annotations

import json
import os
import sys


#: The environment variable naming the JSONL file the calls are
#: appended to.
CALLS_ENV_VAR = "GH_CALLS_JSONL"

#: Where the calls land when the environment variable is unset.
DEFAULT_CALLS_FILE = "GH_CALLS.jsonl"


def main(argv):
    """Record the call and return the stub's exit code.

    Args:
        argv: The process argv, including the program name at index 0.

    Returns:
        ``0`` — the stub always succeeds, so a case reads the recorded
        call rather than the exit code to learn what happened.
    """
    calls = list(argv[1:])
    target = os.environ.get(CALLS_ENV_VAR) or DEFAULT_CALLS_FILE

    with open(target, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(calls, ensure_ascii=False) + "\n")

    print(json.dumps({"ok": True, "argv": calls}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
